{
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "buildCommand": "npm run build && npx staticrypt dist -r -d dist -p '你的密碼' --short",
    "devCommand": "npm run start",
    "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "status": 404, "dest": "/404" }
      ]
}
